{
	"name": "obsidian-copy-inline-code-plugin",
	"version": "2.1.0",
	"description": "This is a plugin for Obsidian that adds an icon inside each inline code, which when clicked, copies the content of the code into the clipboard.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint src manifest.json eslint.config.mts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Ondrej Zavodny, Vitovt",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=18.18.0"
	},
	"dependencies": {
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@eslint/json": "^0.14.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"allowScripts": {
		"esbuild@0.25.5": true
	}
}
